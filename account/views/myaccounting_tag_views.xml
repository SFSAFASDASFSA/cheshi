<odoo>

    <record id="myaccounting_tag_view_tree" model="ir.ui.view">
        <field name="name">myaccounting_tag_view_tree</field>
        <field name="model">myaccounting.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>



    <record id="myaccounting_tag_act_window" model="ir.actions.act_window" >
       <field name="name">会计标签</field>
       <field name="res_model">myaccounting.tag</field>
       <field name="view_mode">list</field>
    </record>
</odoo>