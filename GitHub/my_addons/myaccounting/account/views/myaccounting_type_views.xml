<odoo>
    <!-- 树视图 -->
    <record id="myaccounting_type_view_tree" model="ir.ui.view">
        <field name="name">myaccounting_type_view_tree</field>
        <field name="model">account.move.test</field>
        <field name="arch" type="xml">
            <list string="明细分类账">
                <field name="date"/>
                <field name="voucher_number"/>
                <field name="abstract"/>
                <field name="debtor"/>
                <field name="creditor"/>
                <field name="balance_type"/>
                <field name="balance"/>
<!--                <field name="initial_balance"/>-->
<!--                <field name="current_period_total"/>-->
            </list>
        </field>
    </record>

    <!-- 表单视图 -->
    <record id="myaccounting_type_view_form" model="ir.ui.view">
        <field name="name">myaccounting_type_view_form</field>
        <field name="model">account.move.test</field>
        <field name="arch" type="xml">
            <form string="明细分类账">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="voucher_number"/>
                        <field name="abstract"/>
                        <field name="debtor"/>
                        <field name="creditor"/>
                        <field name="balance_type"/>
                        <field name="coding"/>
                        <field name="balance"/>
<!--                        <field name="initial_balance"/>-->
<!--                        <field name="current_period_total"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 搜索视图 -->
    <record id="myaccounting_type_view_search" model="ir.ui.view">
    <field name="name">myaccounting_type_view_search</field>
    <field name="model">account.move.test</field>
    <field name="arch" type="xml">
        <search string="明细分类账">
            <filter name="voucher_number"/>
            <filter name="coding"/>
            <searchpanel>
                <field name="coding" icon="fa-building" enable_counters="1"/>
            </searchpanel>
        </search>
    </field>
</record>

    <!-- 动作定义 -->
    <record id="myaccounting_type_act_window" model="ir.actions.act_window">
        <field name="name">明细分类账</field>
        <field name="res_model">account.move.test</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="myaccounting_type_view_search"/>
        <field name="domain">[]</field> <!-- 留空，由 Python 代码动态设置 -->
    </record>

</odoo>