<odoo>

    <!-- 树形视图 -->
    <record id="myaccounting_offer_view_tree" model="ir.ui.view">
        <field name="name">myaccounting_offer_view_tree</field>
        <field name="model">myaccounting.offer</field>
        <field name="arch" type="xml">
            <list default_order="coding asc">
                <field name="coding" string="科目编码"/>
                <field name="date"/>
                <field name="voucher_number"/>
                <field name="abstract"/>
<!--                <field name="tag_names" string="科目名称"/>-->
                <field name="initial_balance_debtor" string="期初余额(借方)"/>
                <field name="initial_balance_creditor" string="期初余额(贷方)"/>
                <field name="current_period_debtor" string="本期发生额(借方)"/>
                <field name="current_period_creditor" string="本期发生额(贷方)"/>
                <field name="year_to_date_debtor" string="本年累计发生额(借方)"/>
                <field name="year_to_date_creditor" string="本年累计发生额(贷方)"/>
                <field name="final_balance_debtor" string="期末余额(借方)"/>
                <field name="final_balance_creditor" string="期末余额(贷方)"/>
                <field name="balance_type" string="方向"/>
            </list>
        </field>
    </record>

