    <!-- 搜索视图 -->
    <record id="myaccounting_offer_search_view" model="ir.ui.view">
        <field name="name">myaccounting_offer_search_view</field>
        <field name="model">myaccounting.offer</field>
        <field name="arch" type="xml">
            <search string="科目余额搜索">
                <field name="date" string="日期"/>
                <field name="voucher_number" string="凭证号"/>
                <field name="abstract" string="摘要"/>
                <field name="balance_type" string="方向"/>
                <group expand="0" string="展开">
                    <!-- 将按日期分组改为按科目编码分组 -->
                    <filter name="group_by_coding" string="按科目编码分组"
                            context="{'group_by': 'coding'}"/>
                    <filter name="group_by_balance_type" string="按方向分组" context="{'group_by': 'balance_type'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- 更新行动定义，关联搜索视图 -->
    <record id="myaccounting_offer_act_window" model="ir.actions.act_window">
        <field name="name">科目余额</field>
        <field name="res_model">myaccounting.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('balance_type', 'in', ['debtor', 'creditor', 'balance'])]</field>
        <field name="context">{'search_default_group_by_coding': 1}</field>
        <field name="search_view_id" ref="myaccounting_offer_search_view"/>
    </record>

</odoo>