<odoo>
    <data>
     <record id="myaccounting_property_view_tree" model="ir.ui.view">
        <field name="name">myaccounting_property_view_tree</field>
        <field name="model">myaccounting.property</field>
        <field name="arch" type="xml">
             <list>
                <field name="sequence"/>
            <field name="name"/>
            <field name="coding"/>
            <field name="year"/>
            <field name="period"/>
            <field name="abstract"/>
            <field name="period_type"/>
            <field name="borrowing_balance"/>
            <field name="loan_amount"/>
            <field name="balance_type"/>
            <field name="total_price"/>
            </list>
        </field>
    </record>


<record id="myaccounting_property_view_form" model="ir.ui.view">
    <field name="name">myaccounting_property_view_form</field>
    <field name="model">myaccounting.property</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="do_action_abnormal" type="object" string="异常"/>
                <button name="do_action_locked" type="object" string="锁定"/>
                <button name="%(myaccounting_type_act_window)d" type="action" string="明细分类账"/>
                <field name="state" widget="statusbar" statusbar_visible="abnormal,locked"/>
            </header>
            <sheet>
                <h1>
                    <field name="name"/>
                </h1>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>

                <group>
                    <group>
                        <field name="coding"/>
                        <field name="year"/>
                    </group>
                    <group>
                        <field name="period"/>
                        <field name="abstract"/>
                    </group>
                </group>
                <notebook>
                    <page string="金额描述">
                        <group>
                            <field name="period_type"/>
                            <field name="borrowing_balance"/>
                            <field name="loan_amount"/>
                            <field name="balance_type"/>
                            <field name="total_price"/>
                        </group>
                    </page>
                    <page string="其他信息">
                        <group>
                            <field name="voucher_number"/>
                            <field name="money_lender_id"/>
                            <field name="borrower_id"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

    <record id="myaccounting_property_view_search" model="ir.ui.view">
    <field name="name">myaccounting_property_view_search</field>
    <field name="model">myaccounting.property</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="coding"/>
            <field name="period_type"/>
            <field name="abstract"/>
            <field name="borrowing_balance"/>
            <field name="balance_type"/>
            <field name="loan_amount"/>
            <field name="total_price"/>
            <separator/>
            <filter string="序号" name="sequence" domain="['|', ('state', '=', 'voucher_number'), ('state', '=', 'coding')]"/>
            <group expand="1" string="Group By">
                <filter string="科目编码" name="coding" context="{'group_by':'coding'}"/>
            </group>
        </search>
    </field>
</record>


    <record id="myaccounting_property_act_window" model="ir.actions.act_window">
       <field name="name">总分类账</field>
       <field name="res_model">myaccounting.property</field>
       <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>